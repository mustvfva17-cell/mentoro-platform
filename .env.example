# Public values may be used by browser-side Supabase Auth only.
# Never put a Supabase secret/service-role key in a VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration for Vercel API functions.
# Use the test Supabase project in local/Preview environments.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Reserved for separately reviewed server-only workflows; not used by /api/auth/me.
# Never expose this value to the browser or commit it to Git.
SUPABASE_SECRET_KEY=
